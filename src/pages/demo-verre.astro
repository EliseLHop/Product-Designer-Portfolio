---
// Page de démo du verre WebGL (non liée dans le menu, non indexée).
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---
<Layout current="projects">
<Fragment slot="head">
<title>Glass demo | Elise L’Hopitault</title>
<meta name="robots" content="noindex,nofollow">
</Fragment>

<main id="main">
  <div class="intro">
    <h1>Glass demo</h1>
    <p>Prototype : fond provisoire et vitres dessinées en WebGL, avec les réglages retenus. Utilise le panneau en bas à droite pour ajuster l’effet en direct.</p>
  </div>

  <section class="glass-stage" id="glass-stage">
    <canvas class="glass-canvas" aria-hidden="true"></canvas>
    <div class="stage-content">
      <div class="col">
      <ProjectCard
            href="/gpc"
            image="images/gpc-hero.webp"
            alt="GPC 2.0 report displayed on a tablet held in two hands."
            tags={["Development", "Data Visualization", "PowerBi"]}
            title="GPC 2.0"
            description="Executive reporting in Power BI, built from a Figma mock-up for ENGIE’s business units."
            layout="horizontal"
            priority
          />
      <ProjectCard
            href="/rse"
            image="images/rse-hero.webp"
            alt="Climate – Site report displayed on a laptop."
            tags={["Redesign", "Data Visualization", "PowerBi"]}
            title="RSE Environnement"
            description="Redesign of ENGIE’s climate and environmental risk reports in Power BI."
            layout="horizontal"
          />
      </div>
      <div class="row">
      <ProjectCard
            href="/eventorias"
            image="images/eventorias-hero.webp"
            alt="Eventorias event list on a phone held in a hand."
            tags={["No-code Prototype", "Handoff to Dev"]}
            title="Eventorias"
            description="A “no-code” prototype that helps English-speaking tourists find an event in Paris."
            imagePosition="center 40%"
          />
      <ProjectCard
            href="/flowrate"
            image="images/flowrate-hero.webp"
            alt="Flowrate landing page displayed on a laptop."
            tags={["Ux Audit", "Roadmap"]}
            title="Flowrate"
            description="Understanding why 86% of users drop out of the onboarding process, and a four-month plan to address the issue."
            imagePosition="center 40%"
          />
      <ProjectCard
            href="/bambinets"
            image="images/bambinets-hero.webp"
            alt="Les bambinets app home screen on a phone held in a hand."
            tags={["Accessibility", "Design system"]}
            title="Les bambinets"
            description="A visual identity, an accessible design system, and a prototype sign language app for young children."
            imagePosition="center 40%"
          />
      </div>
    </div>
  </section>

  <form class="panel" id="glass-panel" aria-label="Réglages du verre">
    <div class="panel-title">Glass</div>
    <label>Refraction <input type="range" name="refraction" min="0" max="100" value="86"><output>86</output></label>
    <label>Depth <input type="range" name="depth" min="0" max="100" value="51"><output>51</output></label>
    <label>Dispersion <input type="range" name="dispersion" min="0" max="100" value="9"><output>9</output></label>
    <label>Frost <input type="range" name="frost" min="0" max="100" value="69"><output>69</output></label>
    <label>Splay <input type="range" name="splay" min="0" max="100" value="18"><output>18</output></label>
    <label>Light <input type="range" name="light" min="-180" max="180" value="-134"><output>-134°</output></label>
    <label class="check"><input type="checkbox" name="animate" checked> Fond animé</label>
    <button type="button" id="glass-reset">Réglages par défaut</button>
    <p class="status" id="glass-status"></p>
  </form>
</main>
</Layout>

<script>
  import { mountGlass, GLASS_SETTINGS } from "../scripts/glass";

  const stage = document.getElementById("glass-stage")!;
  const canvas = stage.querySelector("canvas")!;
  const panel = document.getElementById("glass-panel") as HTMLFormElement;
  const status = document.getElementById("glass-status")!;
  const update = mountGlass(stage, canvas, { ...GLASS_SETTINGS });

  if (!update) {
    status.textContent = "WebGL indisponible : version CSS affichée.";
  } else {
    // Chaque curseur met à jour le shader en direct
    panel.addEventListener("input", (event) => {
      const input = event.target as HTMLInputElement;
      if (input.type === "checkbox") return update({ animate: input.checked });
      const out = input.nextElementSibling as HTMLOutputElement;
      out.textContent = input.name === "light" ? `${input.value}°` : input.value;
      update({ [input.name]: Number(input.value) });
    });
    document.getElementById("glass-reset")!.addEventListener("click", () => {
      for (const [key, value] of Object.entries(GLASS_SETTINGS)) {
        const input = panel.elements.namedItem(key) as HTMLInputElement;
        if (input.type === "checkbox") input.checked = value as boolean;
        else {
          input.value = String(value);
          (input.nextElementSibling as HTMLOutputElement).textContent = key === "light" ? `${value}°` : String(value);
        }
      }
      update({ ...GLASS_SETTINGS });
    });
  }
</script>

<style>
  .intro { max-width: 1427px; margin: 0 auto; padding: 56px 32px 40px; box-sizing: border-box; }
  .intro h1 { margin: 0 0 12px; font-family: "Roboto Mono", monospace; font-size: 40px; color: #641822; }
  .intro p { margin: 0; max-width: 640px; font-size: 17px; line-height: 1.5; color: #3D2F2A; }

  /* La scène : le canvas couvre toute la section, les cartes passent par-dessus */
  .glass-stage { position: relative; overflow: hidden; }
  .glass-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .stage-content {
    position: relative;
    max-width: 1427px; margin: 0 auto; padding: 80px 32px 120px; box-sizing: border-box;
    display: flex; flex-direction: column; gap: 72px;
  }
  .col { display: flex; flex-direction: column; gap: 56px; }
  .row { display: flex; flex-wrap: wrap; gap: 40px; align-items: stretch; }

  /* Panneau de réglages, inspiré du panneau Glass de Figma */
  .panel {
    position: fixed; right: 16px; bottom: 16px; z-index: 30;
    width: 250px; padding: 14px 16px; box-sizing: border-box;
    background: #fff; color: #3D2F2A; border-radius: 12px;
    box-shadow: 0 8px 28px rgba(61, 47, 42, 0.18);
    font-size: 13px; display: flex; flex-direction: column; gap: 8px;
  }
  .panel-title { font-weight: 700; font-size: 14px; color: #641822; }
  .panel label { display: grid; grid-template-columns: 74px 1fr 34px; align-items: center; gap: 8px; }
  .panel label.check { display: flex; gap: 8px; }
  .panel input[type="range"] { width: 100%; accent-color: #641822; }
  .panel output { text-align: right; font-variant-numeric: tabular-nums; }
  .panel button {
    margin-top: 4px; padding: 8px; border: 1.5px solid #641822; border-radius: 999px;
    background: none; color: #641822; font: inherit; font-weight: 600; cursor: pointer;
  }
  .status { margin: 0; color: #8B5A61; }
  .status:empty { display: none; }

  @media (max-width: 768px) {
    .stage-content { padding: 48px 20px 260px; gap: 48px; }
    .panel { left: 12px; right: 12px; bottom: 12px; width: auto; padding: 10px 14px; gap: 4px; }
  }
</style>
