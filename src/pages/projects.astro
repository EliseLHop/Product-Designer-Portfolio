---
import Layout from "../layouts/Layout.astro";
---
<Layout current="projects">
<Fragment slot="head">
<title>Projects | Elise L’Hopitault</title>
<meta name="description" content="Case studies by Elise L’Hopitault: Power BI reporting at ENGIE, and school projects in UX audit, accessibility and design systems.">
<meta name="robots" content="index,follow">
<meta name="theme-color" content="#F5F3EE">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Elise L’Hopitault">
<meta property="og:title" content="Projects | Elise L’Hopitault">
<meta property="og:description" content="Case studies by Elise L’Hopitault: Power BI reporting at ENGIE, and school projects in UX audit, accessibility and design systems.">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Projects | Elise L’Hopitault">
<meta name="twitter:description" content="Case studies by Elise L’Hopitault: Power BI reporting at ENGIE, and school projects in UX audit, accessibility and design systems.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23F5F3EE'/%3E%3Ctext x='32' y='43' text-anchor='middle' font-family='Georgia,serif' font-weight='700' font-size='30' fill='%23641822'%3EEL%3C/text%3E%3C/svg%3E">
<link rel="preload" href="/fonts/roboto-mono.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
</Fragment>
<main id="main">

<h1 class="sr-only">Projects</h1>
<!-- LABEL -->
<div style="display:flex;align-items:center;justify-content:center;padding:40px 40px 0">
  <span style="font-size:16px;letter-spacing:.08em;text-transform:uppercase;color:#641822">Portfolio</span>
</div>

<!-- MY CASES STUDY -->
<div style="width:100%;max-width:1427px;margin:70px auto 0;padding:0 32px;box-sizing:border-box">
  <h2 style="margin:0 0 46px;font-family:'Roboto Mono',monospace;font-weight:700;font-size:32px;line-height:1.2;color:#641822">My cases study</h2>
  <div style="display:flex;flex-wrap:wrap;gap:48px 71px;align-items:flex-start">

    <div style="flex:1 1 280px;max-width:407px;min-width:0">
      <img decoding="async" fetchpriority="high" src="images/gpc-hero.webp" alt="GPC 2.0 report displayed on a tablet held in two hands." style="display:block;width:100%;aspect-ratio:407/233;object-fit:cover">
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0 11px">
        <span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Development</span>
        <span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Data Visualization</span><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">PowerBi</span>
      </div>
      <div style="margin:20px 0 0 11px">
        <div style="font-family:'Roboto Mono',monospace;font-weight:600;font-size:18px;letter-spacing:.06em;margin-bottom:4px">GPC 2.0</div>
        <p style="margin:0;font-size:16px;line-height:1.25">Executive reporting in Power BI, built from a Figma mock-up for ENGIE’s business units.</p>
        <a href="/gpc" style="display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-weight:600;font-size:16px;text-decoration:none;color:#641822">View case study<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#641822" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
      </div>
    </div>

    <div style="flex:1 1 280px;max-width:407px;min-width:0">
      <img decoding="async" loading="lazy" src="images/rse-hero.webp" alt="Climate – Site report displayed on a laptop." style="display:block;width:100%;aspect-ratio:407/233;object-fit:cover">
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0 11px">
        <span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Redesign</span>
        <span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Data Visualization</span><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">PowerBi</span>
      </div>
      <div style="margin:20px 0 0 11px">
        <div style="font-family:'Roboto Mono',monospace;font-weight:600;font-size:18px;letter-spacing:.06em;margin-bottom:4px">RSE Environnement</div>
        <p style="margin:0;font-size:16px;line-height:1.25">Redesign of ENGIE’s climate and environmental risk reports in Power BI.</p>
        <a href="/rse" style="display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-weight:600;font-size:16px;text-decoration:none;color:#641822">View case study<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#641822" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
      </div>
    </div>

  </div>
</div>

<!-- MY SCHOOL'S CASES STUDY -->
<div style="width:100%;max-width:1427px;margin:96px auto 0;padding:0 32px;box-sizing:border-box">
  <h2 style="margin:0 0 46px;font-family:'Roboto Mono',monospace;font-weight:700;font-size:32px;line-height:1.2;color:#641822">My school’s cases study</h2>
  <div style="display:flex;flex-wrap:wrap;gap:48px 71px;align-items:flex-start">

    <div style="flex:1 1 280px;max-width:407px;min-width:0">
      <img decoding="async" loading="lazy" src="images/eventorias-hero.webp" alt="Eventorias event list on a phone held in a hand." style="display:block;width:100%;aspect-ratio:407/233;object-fit:cover;object-position:center 40%">
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0 11px">
        <span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">No-code Prototype</span>
        <span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Handoff to Dev</span>
      </div>
      <div style="margin:20px 0 0 11px">
        <div style="font-family:'Roboto Mono',monospace;font-weight:600;font-size:18px;letter-spacing:.06em;margin-bottom:4px">Eventorias</div>
        <p style="margin:0;font-size:16px;line-height:1.25">A “no-code” prototype that helps English-speaking tourists find an event in Paris.</p>
        <a href="/eventorias" style="display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-weight:600;font-size:16px;text-decoration:none;color:#641822">View case study<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#641822" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
      </div>
    </div>

    <div style="flex:1 1 280px;max-width:407px;min-width:0">
      <img decoding="async" loading="lazy" src="images/flowrate-hero.webp" alt="Flowrate landing page displayed on a laptop." style="display:block;width:100%;aspect-ratio:407/233;object-fit:cover;object-position:center 40%">
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0 11px">
        <span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Ux Audit</span>
        <span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Roadmap</span>
      </div>
      <div style="margin:20px 0 0 11px">
        <div style="font-family:'Roboto Mono',monospace;font-weight:600;font-size:18px;letter-spacing:.06em;margin-bottom:4px">Flowrate</div>
        <p style="margin:0;font-size:16px;line-height:1.25">Understanding why 86% of users drop out of the onboarding process, and a four-month plan to address the issue.</p>
        <a href="/flowrate" style="display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-weight:600;font-size:16px;text-decoration:none;color:#641822">View case study<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#641822" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
      </div>
    </div>

    <div style="flex:1 1 280px;max-width:407px;min-width:0">
      <img decoding="async" loading="lazy" src="images/bambinets-hero.webp" alt="Les bambinets app home screen on a phone held in a hand." style="display:block;width:100%;aspect-ratio:407/233;object-fit:cover;object-position:center 40%">
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0 11px">
        <span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Accessibility</span>
        <span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Design system</span>
      </div>
      <div style="margin:20px 0 0 11px">
        <div style="font-family:'Roboto Mono',monospace;font-weight:600;font-size:18px;letter-spacing:.06em;margin-bottom:4px">Les bambinets</div>
        <p style="margin:0;font-size:16px;line-height:1.25">A visual identity, an accessible design system, and a prototype sign language app for young children.</p>
        <a href="/bambinets" style="display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-weight:600;font-size:16px;text-decoration:none;color:#641822">View case study<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#641822" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
      </div>
    </div>

  </div>
</div>

</main>
<!-- CONNECT -->
</Layout>
