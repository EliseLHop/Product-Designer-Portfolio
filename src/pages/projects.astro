---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---
<Layout current="projects">
<Fragment slot="head">
<title>Projects | Elise L’Hopitault</title>
<meta name="description" content="Case studies by Elise L’Hopitault: Power BI reporting at ENGIE, and school projects in UX audit, accessibility and design systems.">
<meta name="robots" content="index,follow">
<meta name="theme-color" content="#F5F3EE">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Elise L’Hopitault">
<meta property="og:title" content="Projects | Elise L’Hopitault">
<meta property="og:description" content="Case studies by Elise L’Hopitault: Power BI reporting at ENGIE, and school projects in UX audit, accessibility and design systems.">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Projects | Elise L’Hopitault">
<meta name="twitter:description" content="Case studies by Elise L’Hopitault: Power BI reporting at ENGIE, and school projects in UX audit, accessibility and design systems.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23F5F3EE'/%3E%3Ctext x='32' y='43' text-anchor='middle' font-family='Georgia,serif' font-weight='700' font-size='30' fill='%23641822'%3EEL%3C/text%3E%3C/svg%3E">
<link rel="preload" href="/fonts/roboto-mono.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
</Fragment>
<main id="main">

<h1 class="sr-only">Projects</h1>
<!-- LABEL -->
<div style="display:flex;align-items:center;justify-content:center;padding:40px 40px 0">
  <span style="font-size:16px;letter-spacing:.08em;text-transform:uppercase;color:#641822">Portfolio</span>
</div>

<!-- MY CASES STUDY -->
<div style="width:100%;max-width:1427px;margin:70px auto 0;padding:0 32px;box-sizing:border-box">
  <h2 style="margin:0 0 46px;font-family:'Roboto Mono',monospace;font-weight:700;font-size:32px;line-height:1.2;color:#641822">My cases study</h2>
  <div style="display:flex;flex-wrap:wrap;gap:48px 40px;align-items:stretch">

    <ProjectCard
      href="/gpc"
      image="images/gpc-hero.webp"
      alt="GPC 2.0 report displayed on a tablet held in two hands."
      tags={["Development", "Data Visualization", "PowerBi"]}
      title="GPC 2.0"
      description="Executive reporting in Power BI, built from a Figma mock-up for ENGIE’s business units."
      priority
    />

    <ProjectCard
      href="/rse"
      image="images/rse-hero.webp"
      alt="Climate – Site report displayed on a laptop."
      tags={["Redesign", "Data Visualization", "PowerBi"]}
      title="RSE Environnement"
      description="Redesign of ENGIE’s climate and environmental risk reports in Power BI."
    />

  </div>
</div>

<!-- MY SCHOOL'S CASES STUDY -->
<div style="width:100%;max-width:1427px;margin:96px auto 0;padding:0 32px;box-sizing:border-box">
  <h2 style="margin:0 0 46px;font-family:'Roboto Mono',monospace;font-weight:700;font-size:32px;line-height:1.2;color:#641822">My school’s cases study</h2>
  <div style="display:flex;flex-wrap:wrap;gap:48px 40px;align-items:stretch">

    <ProjectCard
      href="/eventorias"
      image="images/eventorias-hero.webp"
      alt="Eventorias event list on a phone held in a hand."
      tags={["No-code Prototype", "Handoff to Dev"]}
      title="Eventorias"
      description="A “no-code” prototype that helps English-speaking tourists find an event in Paris."
      imagePosition="center 40%"
    />

    <ProjectCard
      href="/flowrate"
      image="images/flowrate-hero.webp"
      alt="Flowrate landing page displayed on a laptop."
      tags={["Ux Audit", "Roadmap"]}
      title="Flowrate"
      description="Understanding why 86% of users drop out of the onboarding process, and a four-month plan to address the issue."
      imagePosition="center 40%"
    />

    <ProjectCard
      href="/bambinets"
      image="images/bambinets-hero.webp"
      alt="Les bambinets app home screen on a phone held in a hand."
      tags={["Accessibility", "Design system"]}
      title="Les bambinets"
      description="A visual identity, an accessible design system, and a prototype sign language app for young children."
      imagePosition="center 40%"
    />

  </div>
</div>

</main>
<!-- CONNECT -->
</Layout>
