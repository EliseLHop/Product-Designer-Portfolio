---
import Layout from "../layouts/Layout.astro";
---
<Layout current="home" padBottom={99}>
<Fragment slot="head">
<title>Elise L’Hopitault | Product Designer</title>
<meta name="description" content="Portfolio of Elise L’Hopitault, junior product designer based in Tours, France. UX audits, design systems and data visualization in Power BI, with a developer background.">
<meta name="robots" content="index,follow">
<meta name="theme-color" content="#F5F3EE">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Elise L’Hopitault">
<meta property="og:title" content="Elise L’Hopitault | Product Designer">
<meta property="og:description" content="Portfolio of Elise L’Hopitault, junior product designer based in Tours, France. UX audits, design systems and data visualization in Power BI, with a developer background.">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Elise L’Hopitault | Product Designer">
<meta name="twitter:description" content="Portfolio of Elise L’Hopitault, junior product designer based in Tours, France. UX audits, design systems and data visualization in Power BI, with a developer background.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23F5F3EE'/%3E%3Ctext x='32' y='43' text-anchor='middle' font-family='Georgia,serif' font-weight='700' font-size='30' fill='%23641822'%3EEL%3C/text%3E%3C/svg%3E">
<link rel="preload" href="/fonts/roboto-mono.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
<script type="application/ld+json" is:inline>{"@context": "https://schema.org", "@type": "Person", "name": "Elise L’Hopitault", "jobTitle": "Product Designer (Junior)", "address": {"@type": "PostalAddress", "addressLocality": "Tours", "addressCountry": "FR"}, "sameAs": ["https://www.linkedin.com/in/elise-lhopitault"], "knowsAbout": ["Product design", "UX research", "UX audit", "Design systems", "Data visualization", "Power BI", "Figma"]}</script>
</Fragment>
<main id="main">

<!-- HERO -->
<div style="display:flex;flex-direction:column;align-items:center;padding:40px 40px 90px;text-align:center">
  <span style="font-size:16px;letter-spacing:.08em;text-transform:uppercase">Portfolio</span>
  <div style="margin-top:300px;font-size:24px;letter-spacing:.02em">Elise L’Hopitault</div>
  <h1 style="margin:8px 0 0;font-family:'Roboto Mono',monospace;font-weight:700;font-size:50px;letter-spacing:.03em;line-height:1.2">Product designer Junior</h1>
  <div style="margin-top:360px;display:flex;flex-wrap:wrap;justify-content:center;gap:8px 24px;font-size:16px;color:#641822">
    <span>UX Research</span><span aria-hidden="true">·</span><span>UX Audit</span><span aria-hidden="true">·</span><span>Data Visualization</span><span aria-hidden="true">·</span><span>Design System</span>
  </div>
</div>

<!-- MY CASES STUDY -->
<div style="width:100%;max-width:1427px;margin:100px auto 0;padding:0 32px 0px;box-sizing:border-box"><h2 style="margin:0 0 107px;font-family:'Roboto Mono',monospace;font-weight:700;font-size:32px;line-height:1.2;color:#641822">My cases study</h2><div style="display:flex;flex-direction:column;gap:88px">
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:48px 28px">
      <img decoding="async" fetchpriority="high" src="images/gpc-hero.webp" alt="GPC 2.0 report displayed on a tablet held in two hands." style="display:block;flex:1 1 320px;max-width:516px;min-width:0;aspect-ratio:516/296;object-fit:cover">
      <div style="flex:1 1 320px;max-width:556px;min-width:0;padding-left:0">
        <div style="display:flex;flex-wrap:wrap;gap:8px"><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Development</span><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Data Visualization</span><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">PowerBi</span></div>
        <div style="font-family:'Roboto Mono',monospace;font-weight:600;font-size:18px;margin:34px 0 6px">GPC 2.0</div>
        <p style="margin:0;font-size:16px;line-height:1.3">Executive reporting in Power BI, built from a Figma mock-up for ENGIE’s business units.</p>
        <a href="/gpc" style="display:inline-flex;align-items:center;gap:8px;margin-top:26px;font-weight:600;font-size:16px;text-decoration:none;color:#641822">View case study<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#641822" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
      </div>
    </div>
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:48px 28px">
      <img decoding="async" loading="lazy" src="images/rse-hero.webp" alt="Climate – Site report displayed on a laptop." style="display:block;flex:1 1 320px;max-width:516px;min-width:0;aspect-ratio:516/296;object-fit:cover">
      <div style="flex:1 1 320px;max-width:556px;min-width:0;padding-left:0">
        <div style="display:flex;flex-wrap:wrap;gap:8px"><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Redesign</span><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Data Visualization</span><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">PowerBi</span></div>
        <div style="font-family:'Roboto Mono',monospace;font-weight:600;font-size:18px;margin:34px 0 6px">RSE Environnement</div>
        <p style="margin:0;font-size:16px;line-height:1.3">Redesign of ENGIE’s climate and environmental risk reports in Power BI.</p>
        <a href="/rse" style="display:inline-flex;align-items:center;gap:8px;margin-top:26px;font-weight:600;font-size:16px;text-decoration:none;color:#641822">View case study<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#641822" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
      </div>
    </div></div></div>

<!-- SCHOOL -->
<div style="width:100%;max-width:1427px;margin:160px auto 0;padding:0 32px 0px;box-sizing:border-box"><h2 style="margin:0 0 70px;font-family:'Roboto Mono',monospace;font-weight:700;font-size:32px;line-height:1.2;color:#641822">My school’s cases study</h2><div style="display:flex;flex-wrap:wrap;gap:48px 71px;align-items:flex-start">
    <div style="flex:1 1 280px;max-width:407px;min-width:0">
      <img decoding="async" loading="lazy" src="images/eventorias-hero.webp" alt="Eventorias event list on a phone held in a hand." style="display:block;width:100%;aspect-ratio:407/233;object-fit:cover;object-position:center 40%">
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0 11px"><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">No-code Prototype</span><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Handoff to Dev</span></div>
      <div style="margin:20px 0 0 11px">
        <div style="font-family:'Roboto Mono',monospace;font-weight:600;font-size:18px;letter-spacing:.06em;margin-bottom:4px">Eventorias</div>
        <p style="margin:0;font-size:16px;line-height:1.25">A “no-code” prototype that helps English-speaking tourists find an event in Paris.</p>
        <a href="/eventorias" style="display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-weight:600;font-size:16px;text-decoration:none;color:#641822">View case study<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#641822" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
      </div>
    </div>
    <div style="flex:1 1 280px;max-width:407px;min-width:0">
      <img decoding="async" loading="lazy" src="images/flowrate-hero.webp" alt="Flowrate landing page displayed on a laptop." style="display:block;width:100%;aspect-ratio:407/233;object-fit:cover;object-position:center 40%">
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0 11px"><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Ux Audit</span><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Roadmap</span></div>
      <div style="margin:20px 0 0 11px">
        <div style="font-family:'Roboto Mono',monospace;font-weight:600;font-size:18px;letter-spacing:.06em;margin-bottom:4px">Flowrate</div>
        <p style="margin:0;font-size:16px;line-height:1.25">Understanding why 86% of users drop out of the onboarding process, and a four-month plan to address the issue.</p>
        <a href="/flowrate" style="display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-weight:600;font-size:16px;text-decoration:none;color:#641822">View case study<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#641822" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
      </div>
    </div>
    <div style="flex:1 1 280px;max-width:407px;min-width:0">
      <img decoding="async" loading="lazy" src="images/bambinets-hero.webp" alt="Les bambinets app home screen on a phone held in a hand." style="display:block;width:100%;aspect-ratio:407/233;object-fit:cover;object-position:center 40%">
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0 11px"><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Accessibility</span><span style="border:1.5px solid #641822;border-radius:999px;padding:4px 12px;font-size:16px;line-height:1.3">Design system</span></div>
      <div style="margin:20px 0 0 11px">
        <div style="font-family:'Roboto Mono',monospace;font-weight:600;font-size:18px;letter-spacing:.06em;margin-bottom:4px">Les bambinets</div>
        <p style="margin:0;font-size:16px;line-height:1.25">A visual identity, an accessible design system, and a prototype sign language app for young children.</p>
        <a href="/bambinets" style="display:inline-flex;align-items:center;gap:8px;margin-top:22px;font-weight:600;font-size:16px;text-decoration:none;color:#641822">View case study<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#641822" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
      </div>
    </div></div></div>

<!-- ABOUT -->
<div style="width:100%;max-width:1427px;margin:170px auto 0;padding:0 32px 0px;box-sizing:border-box"><h2 style="margin:0 0 70px;font-family:'Roboto Mono',monospace;font-weight:700;font-size:32px;line-height:1.2;color:#641822">And about me ?</h2><div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:32px">
    <div style="flex:1 1 400px;max-width:820px;font-size:16px;line-height:1.35">
      <p style="margin:0 0 20px">Having worked in development myself, I now work closely with developers: I design with their constraints in mind and deliver work that’s ready to be implemented.</p>
      <p style="margin:0">I have an eye for detail, and I take on smaller projects on my own to build my autonomy and grow toward project management.</p>
    </div>
    <a href="/about" style="display:inline-flex;align-items:center;gap:10px;background:#641822;color:#F5F3EE;text-decoration:none;font-size:16px;padding:12px 18px;border-radius:6px;margin-right:250px">More about me<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#F5F3EE" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg></a>
  </div></div>

</main>
<!-- CONNECT -->
</Layout>
