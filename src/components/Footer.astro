---
// Pied de page « Let's connect ! », partagé par toutes les pages.
// narrow : largeur 1100px, utilisée sur les études de cas
interface Props { narrow?: boolean }
const { narrow = false } = Astro.props;
---
<footer style="border-top:1px solid #D9D2C7;position:relative;z-index:2"><div style={`width:100%;max-width:${narrow ? "1100px" : "1427px"};margin:0 auto;padding:${narrow ? "90px 24px" : "90px 32px"} 150px;box-sizing:border-box`}><h2 style="margin:0 0 34px;font-family:'Roboto Mono',monospace;font-weight:700;font-size:32px;line-height:1.2;color:#641822">Let’s connect !</h2><div style="display:flex;flex-direction:column;gap:24px;font-size:17px">
    <div style="display:flex;align-items:center;gap:18px">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M1 5l10 7 10-7v12h-3.5V10L11 15.5 4.5 10v7H1z" fill="#641822"></path></svg>
      <a href="mailto:elise.lhopitault.pro@gmail.com" style="color:#641822">elise.lhopitault.pro@gmail.com</a>
    </div>
    <div style="display:flex;align-items:center;gap:18px">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><rect width="22" height="22" rx="3" fill="#641822"></rect><text x="11" y="16" text-anchor="middle" font-family="Instrument Sans, sans-serif" font-weight="700" font-size="12" fill="#F5F3EE">in</text></svg>
      <a href="https://www.linkedin.com/in/elise-lhopitault" target="_blank" rel="noopener noreferrer" style="color:#3D2F2A;text-decoration:none">My Linkedin</a>
    </div>
    <div style="display:flex;align-items:center;gap:18px">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="#641822" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 2h8l5 5v13H5z M13 2v5h5"></path></svg>
      <a href="resume/Elise-LHopitault-CV-Product-Designer-EN.pdf" target="_blank" rel="noopener noreferrer" style="color:#3D2F2A;text-decoration:none">My resume</a>
    </div>
  </div></div>

</footer>
