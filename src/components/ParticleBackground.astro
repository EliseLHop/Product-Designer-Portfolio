---
// Fond animé du portfolio : grille de points en vague, dessinée en canvas 2D.
// Placé une seule fois dans le Layout, derrière tout le contenu.
// Les paramètres de la vague sont dans src/scripts/wave.ts.
---
<canvas class="particle-bg" aria-hidden="true"></canvas>

<script>
  import { WAVE, gridGap, gridOrigin, waveHeight, dotRadius, dotOpacity, reducedMotion, waveTime } from "../scripts/wave";

  const canvas = document.querySelector<HTMLCanvasElement>(".particle-bg")!;
  const ctx = canvas.getContext("2d");

  if (ctx) {
    // Les points sont regroupés par niveau d'opacité : un seul remplissage par niveau
    // au lieu d'un par point, ce qui rend le dessin beaucoup plus rapide.
    const LEVELS = 24;
    const [r, g, b] = WAVE.color;
    const fills = Array.from({ length: LEVELS }, (_, i) => {
      const h = (i / (LEVELS - 1)) * 2 - 1;
      return `rgba(${r},${g},${b},${dotOpacity(h).toFixed(4)})`;
    });

    let width = 0;
    let height = 0;
    let frame = 0;

    // Taille du canvas = taille de l'écran × densité (plafonnée à 2)
    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0); // on dessine ensuite en pixels CSS
      draw();
    }

    function draw() {
      const t = waveTime();
      const gap = gridGap();
      const origin = gridOrigin(gap);
      const maxX = width + WAVE.amplitude + gap;
      const maxY = height + WAVE.amplitude + gap;
      const paths = Array.from({ length: LEVELS }, () => new Path2D());

      for (let y = origin; y <= maxY; y += gap) {
        for (let x = origin; x <= maxX; x += gap) {
          const h = waveHeight(x, y, t);
          const radius = dotRadius(h);
          const dotY = y + h * WAVE.amplitude;
          const level = Math.round(((h + 1) / 2) * (LEVELS - 1));
          const path = paths[Math.min(LEVELS - 1, Math.max(0, level))];
          path.moveTo(x + radius, dotY);
          path.arc(x, dotY, radius, 0, Math.PI * 2);
        }
      }

      ctx!.clearRect(0, 0, width, height);
      paths.forEach((path, i) => {
        ctx!.fillStyle = fills[i];
        ctx!.fill(path);
      });
    }

    function loop() {
      draw();
      frame = requestAnimationFrame(loop);
    }
    function play() {
      if (!frame && !reducedMotion() && !document.hidden) frame = requestAnimationFrame(loop);
    }
    function pause() {
      cancelAnimationFrame(frame);
      frame = 0;
    }

    // Pause quand l'onglet n'est pas visible
    document.addEventListener("visibilitychange", () => (document.hidden ? pause() : play()));
    window.addEventListener("resize", resize);
    // Si la personne change sa préférence d'animation en cours de visite
    window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", () => {
      pause();
      draw();
      play();
    });

    resize();
    play();
  }
</script>

<style>
  .particle-bg {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
  }
</style>
